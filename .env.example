# -------------------------------------------------------------
# AI Marketing Automation Platform - Environment Configuration
# -------------------------------------------------------------

# Project Config
PROJECT_NAME="AI Marketing Automation & Campaign Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL in production, SQLite fallback in local/testing)
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/marketing_platform"
DATABASE_FALLBACK_SQLITE=True
SQLITE_DB_PATH="sqlite:///./marketing_platform.db"

# AI Provider Selection: "mock" | "openai" | "anthropic"
LLM_MODE="mock"

# OpenAI Configuration (Optional if LLM_MODE=mock)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Configuration (Optional if LLM_MODE=mock)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# AI Execution Limits
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# Frontend Environment Variables
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
